        onWsChange={(w) => { setWs(w); setTab("home"); }}
        workspaces={workspaces}
      />

      <div className="flex-1 flex flex-col overflow-hidden min-w-0">
        <Topbar title={tabLabel[tab]} ws={ws} />
        <main className="flex-1 overflow-y-auto">
          {tab === "home"       && <HomePage       ws={ws} contacts={contacts} onChange={setTab} />}
          {tab === "contacts"   && <ContactsPage   contacts={contacts} />}
          {tab === "automation" && <AutomationPage ws={ws} refreshData={refreshData} />}
          {tab === "ai"         && <AIPage         />}
          {tab === "inbox"      && <InboxPage      contacts={contacts} />}
          {tab === "analytics"  && <AnalyticsPage  ws={ws} contacts={contacts} />}
          {tab === "settings"   && <SettingsPage   ws={ws} />}
        </main>
      </div>
    </div>
  );
