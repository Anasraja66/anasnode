// ─── Analytics Page ────────────────────────────────────────────────────────────

function AnalyticsPage({ ws, contacts }: { ws: Workspace; contacts: Contact[] }) {
  const totalRuns = ws.automations.reduce((sum, a) => sum + a.runs, 0);
  const leadsCaptured = contacts.length;
  const aiEnriched = contacts.filter(c => c.tags.includes("hot-lead")).length;
  const bookingsMade = ws.automations.filter(a => a.type === "calendar").reduce((sum, a) => sum + a.runs, 0);

  const days = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
  
  // Dynamic or fallback bar heights based on real runs!
  const hasData = totalRuns > 0 || leadsCaptured > 0;
  
  const inbound = hasData ? [leadsCaptured, Math.floor(leadsCaptured * 0.8), Math.floor(leadsCaptured * 1.2), Math.floor(leadsCaptured * 0.6), Math.
          { label: "AI enriched", value: "386", delta: "+8.1%" },
          { label: "Messages sent", value: "8,412", delta: "+24.0%" },
          { label: "Bookings made", value: "124", delta: "+15.2%" },
        ].map(s => (
          <div key={s.label} className="rounded-xl border border-zinc-200 bg-white p-4">
            <p className="text-[11.5px] text-zinc-400 font-medium">{s.label}</p>
            <div className="mt-2 flex items-baseline gap-2">
              <span className="text-[22px] font-bold text-zinc-900 tabular-nums">{s.value}</span>
              <span className="text-[11px] font-semibold text-emerald-500">{s.delta}</span>
            </div>
          </div>
        ))}
      </div>

      <div className="rounded-xl border border-zinc-200 bg-white overflow-hidden">
        <div cl
          <div>
            <h2 className="text-[13px] font-bold text-zinc-900">Conversation volume</h2>
            <p className="text-[11.5px] text-zinc-400 mt-0.5">Inbound vs auto-replies — last 7 days</p>
          </div>
          <div className="flex items-center gap-4 text-[11.5px] text-zinc-500">
            <span className="flex items-center gap-1.5"><span className="w-2.5 h-2.5 rounded-sm bg-zinc-200 inline-block" />Inbound</span>
            <span className="flex items-center gap-1.5"><span className="w-2.5 h-2.5 rounded-sm bg-zinc-800 inline-block" />Auto-reply</span>
          </div>
        </div>
        <div className="px-6 pt-6 pb-4">
          <div className="flex items-end gap-4 h-36">
            {days.map((d, i) => (
              <div key={d} className="flex-1 flex flex-col items-center gap-3 h-full justify-end">
                <div className="w-full flex gap-1 items-end justify-center h-full">
                  <div className="w-full rounded-t-[3px] bg-zinc-100" style={{ height: `${(inbound[i] / 100) * 100}%` }} />
                  <div className="w-full rounded-t-[3px] bg-zinc-800" style={{ height: `${(outbound[i] / 100) * 100}%` }} />
                </div>
                <span className="text-[10.5px] font-mono text-zinc-400">{d}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  );
}

