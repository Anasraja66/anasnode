  const refreshData = async () => {
    try {
      const res = await fetch("/api/dashboard/data");
      const data = await res.json();
      if (data.success && data.workspaces?.length > 0) {
        setWorkspaces(data.workspaces);
        setWs(currentWs => {
          if (!currentWs) {
            const params = new URLSearchParams(window.location.search);
            return data.workspaces.find((w: any) => w.id === params.get("ws")) || data.workspaces[0];
          }
          return data.workspaces.find((w: any) => w.id === currentWs.id) || data.workspaces[0];
        });
        if (data.contacts) {
          setContacts(data.contacts);
        }
      } else {
        setWorkspaces([]);
        setWs(null);
      }
    } catch (err) {
      console.error("Error refreshing dashboard data:", err);
    }
  };

  useEffect(() => {
    setMounted(true);
    async function init() {
      try {
        await refreshData();
      } finally {
        setLoading(false);
      }
