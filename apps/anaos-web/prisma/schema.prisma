datasource db {
  provider = "postgresql"
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

model Account {
  id                 String                  @id @default(uuid())
  email              String                  @unique
  name               String?
  createdAt          DateTime                @default(now())
  workspaces         Workspace[]
  workflows          Workflow[]
  credentials        IntegrationCredential[]
  users              User[]
  conversations      InboxConversation[]
  broadcasts         BroadcastCampaign[]
  invites            TeamInvite[]
  bookingEvents      BookingEvent[]
  pendingActions     PendingAction[]
  subscription       Subscription?
  creditBalance      CreditBalance?
  creditTransactions CreditTransaction[]
  usageLogs          UsageLog[]

  @@map("accounts")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("owner")
  accountId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("users")
}

model Workspace {
  id               String     @id @default(uuid())
  accountId        String
  name             String
  industry         String
  slug             String
  status           String     @default("draft")
  version          Int        @default(1)
  languageSettings String     @default("")
  createdAt        DateTime   @default(now())
  account          Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  workflows        Workflow[]

  @@map("workspaces")
}

model Workflow {
  id             String              @id @default(uuid())
  accountId      String
  workspaceId    String
  name           String
  description    String?
  isActive       Boolean             @default(false)
  mode           String              @default("draft") // draft|autopilot
  version        Int                 @default(1)
  nodes          String // Stringified JSON WorkflowNode[]
  edges          String // Stringified JSON WorkflowEdge[]
  variables      String              @default("[]") // Stringified JSON string[]
  stats          String              @default("{\"runs\":0,\"success\":0,\"failed\":0}")
  lastRunAt      DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  account        Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  workspace      Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  executions     WorkflowExecution[]
  pendingActions PendingAction[]

  @@map("workflows")
}

model PendingAction {
  id           String   @id @default(uuid())
  accountId    String
  workflowId   String
  contactPhone String?
  channel      String   @default("whatsapp")
  actionType   String // send_message, book_appointment, etc.
  payload      String // Stringified JSON of the action payload (e.g. { body: "..." })
  status       String   @default("pending") // pending|approved|rejected|sent
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  workflow     Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("pending_actions")
}

model WorkflowExecution {
  id         String    @id @default(uuid())
  workflowId String
  contactId  String?
  status     String    @default("running") // running|success|failed|timeout
  input      String    @default("{}") // Stringified JSON
  output     String    @default("{}") // Stringified JSON
  logs       String    @default("[]") // Stringified JSON WorkflowExecutionLog[]
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  duration   Int? // milliseconds
  workflow   Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@map("workflow_executions")
}

model PlatformMetaSettings {
  id                  String   @id @default("default")
  metaAppId           String?
  metaAppSecretEnc    String?
  metaFbLoginConfigId String?
  updatedAt           DateTime @updatedAt

  @@map("platform_meta_settings")
}

model InboxConversation {
  id            String         @id @default(uuid())
  accountId     String
  workspaceId   String?
  channel       String         @default("whatsapp")
  contactPhone  String
  contactName   String         @default("Customer")
  firstName     String         @default("")
  lastName      String         @default("")
  email         String         @default("")
  gender        String         @default("")
  customFields  String         @default("{}")
  lastMessage   String         @default("")
  lastMessageAt DateTime       @default(now())
  unreadCount   Int            @default(0)
  aiEnabled     Boolean        @default(true)
  tags          String         @default("[]")
  optedOut      Boolean        @default(false)
  lastInboundAt DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  account       Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  messages      InboxMessage[]

  @@unique([accountId, channel, contactPhone])
  @@map("inbox_conversations")
}

model InboxMessage {
  id             String            @id @default(uuid())
  conversationId String
  direction      String
  body           String
  source         String            @default("customer")
  createdAt      DateTime          @default(now())
  conversation   InboxConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("inbox_messages")
}

model IntegrationCredential {
  id          String   @id @default(uuid())
  accountId   String
  type        String // openai|claude|gemini|custom_llm|google_calendar|shopify|hubspot|whatsapp|instagram|telegram|smtp
  name        String // user-given name e.g. "My OpenAI Key"
  credentials String // encrypted JSON key-value pairs
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("integration_credentials")
}

model BroadcastCampaign {
  id               String    @id @default(uuid())
  accountId        String
  workspaceId      String?
  name             String
  status           String    @default("draft")
  category         String    @default("marketing")
  languageCode     String    @default("en")
  bodyText         String
  footerText       String    @default("")
  optOutLine       String    @default("Reply STOP to opt out.")
  outside24h       Boolean   @default(true)
  audienceFilter   String    @default("{}")
  scheduleAt       DateTime?
  dailyCap         Int       @default(250)
  sentCount        Int       @default(0)
  failedCount      Int       @default(0)
  promptSource     String?
  metaTemplateName String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  account          Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("broadcast_campaigns")
}

model TeamInvite {
  id         String    @id @default(uuid())
  accountId  String
  email      String
  role       String    @default("agent")
  token      String    @unique @default(uuid())
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())
  account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("team_invites")
}

model BookingEvent {
  id           String   @id @default(uuid())
  accountId    String
  contactPhone String
  contactName  String   @default("Customer")
  title        String   @default("Appointment")
  startAt      DateTime
  endAt        DateTime
  notes        String   @default("")
  channel      String   @default("whatsapp")
  status       String   @default("confirmed")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("booking_events")
}

model Subscription {
  id                   String    @id @default(uuid())
  accountId            String    @unique
  planId               String    @default("free_trial")
  status               String    @default("active") // active|past_due|canceled|trialing
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  account              Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model CreditBalance {
  id             String   @id @default(uuid())
  accountId      String   @unique
  balance        Int      @default(0)
  totalPurchased Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("credit_balances")
}

model CreditTransaction {
  id          String   @id @default(uuid())
  accountId   String
  amount      Int // Positive for top-up, Negative for usage
  type        String // "top_up" | "usage" | "refund" | "trial_bonus"
  description String
  createdAt   DateTime @default(now())
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("credit_transactions")
}

model UsageLog {
  id              String   @id @default(uuid())
  accountId       String
  actionType      String // "workflow_execution" | "voice_call_minute" | "prompt_generation"
  creditCost      Int
  relatedEntityId String? // e.g. WorkflowExecution ID
  createdAt       DateTime @default(now())
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("usage_logs")
}
