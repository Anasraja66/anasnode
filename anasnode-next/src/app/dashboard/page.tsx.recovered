      {/* Welcome */}
      <div className="flex items-center justify-between">
        <div>
          <h1 className="text-[20px] font-semibold tracking-tight text-zinc-900 leading-tight">Welcome back, Anas 👋</h1>
          <p className="text-[12px] font-medium text-zinc-400 mt-1">{ws.name} · {ws.industry}</p>
