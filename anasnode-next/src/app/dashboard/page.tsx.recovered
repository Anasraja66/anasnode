function InboxPage({ contacts }: { contacts: Contact[] }) {
  const [activeId, setActiveId] = useState<string | null>(contacts.length > 0 ? contacts[0].id : null);
  const [typedMessage, setTypedMessage] = useState("");
  const [isTyping, setIsTyping] = useState(false);
  const [chatLogs, setChatLogs] = useState<Record<string, { from: "user" | "bot"; text: string }[]>>({});

  const activeContact = contacts.find(c => c.id === activeId) || (contacts.length > 0 ? contacts[0] : null);

  // Sync active id if contacts change (e.g. workspace switched)
  useEffect(() => {
    if (contacts.length > 0) {
      if (!activeId || !contacts.some(c => c.id === activeId)) {
        setActiveId(contacts[0].id);
      }
    } else {
      setActiveId(null);
    }
}

