generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                 String                  @id @default(uuid())
  email              String                  @unique
  name               String?
  createdAt          DateTime                @default(now())
  bookingEvents      BookingEvent[]
  broadcasts         BroadcastCampaign[]
  creditBalance      CreditBalance?
  creditTransactions CreditTransaction[]
  conversations      InboxConversation[]
  credentials        IntegrationCredential[]
  pendingActions     PendingAction[]
  subscription       Subscription?
  invites            TeamInvite[]
  usageLogs          UsageLog[]
  users              User[]
  workflows          Workflow[]
  workspaces         Workspace[]
  parties            Party[]

  @@map("accounts")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("owner")
  accountId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("users")
}

model Workspace {
  id               String     @id @default(uuid())
  accountId        String
  name             String
  industry         String
  slug             String
  status           String     @default("draft")
  version          Int        @default(1)
  languageSettings String     @default("")
  createdAt        DateTime   @default(now())
  workflows        Workflow[]
  account          Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("workspaces")
}

model Workflow {
  id             String              @id @default(uuid())
  accountId      String
  workspaceId    String
  name           String
  description    String?
  isActive       Boolean             @default(false)
  version        Int                 @default(1)
  definition     String              @default("{}") // React Flow JSON
  variables      String              @default("[]")
  stats          String              @default("{\"runs\":0,\"success\":0,\"failed\":0}")
  lastRunAt      DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  mode           String              @default("draft")
  voiceAgentId   String?
  voiceProvider  String?
  pendingActions PendingAction[]
  executions     WorkflowExecution[]
  account        Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  workspace      Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workflows")
}

model PendingAction {
  id           String   @id @default(uuid())
  accountId    String
  workflowId   String
  contactPhone String?
  channel      String   @default("whatsapp")
  actionType   String
  payload      String
  status       String   @default("pending")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  workflow     Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@map("pending_actions")
}

model WorkflowExecution {
  id         String    @id @default(uuid())
  workflowId String
  contactId  String?
  status     String    @default("running")
  input      String    @default("{}")
  output     String    @default("{}")
  logs       String    @default("[]")
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  duration   Int?
  workflow   Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@map("workflow_executions")
}

model PlatformMetaSettings {
  id                  String   @id @default("default")
  metaAppId           String?
  metaAppSecretEnc    String?
  metaFbLoginConfigId String?
  updatedAt           DateTime @updatedAt

  @@map("platform_meta_settings")
}

model InboxConversation {
  id            String         @id @default(uuid())
  accountId     String
  workspaceId   String?
  channel       String         @default("whatsapp")
  contactPhone  String
  contactName   String         @default("Customer")
  firstName     String         @default("")
  lastName      String         @default("")
  email         String         @default("")
  gender        String         @default("")
  customFields  String         @default("{}")
  lastMessage   String         @default("")
  lastMessageAt DateTime       @default(now())
  unreadCount   Int            @default(0)
  aiEnabled     Boolean        @default(true)
  tags          String         @default("[]")
  optedOut      Boolean        @default(false)
  lastInboundAt DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  account       Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  messages      InboxMessage[]

  @@unique([accountId, channel, contactPhone])
  @@map("inbox_conversations")
}

model InboxMessage {
  id             String            @id @default(uuid())
  conversationId String
  direction      String
  body           String
  source         String            @default("customer")
  createdAt      DateTime          @default(now())
  conversation   InboxConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("inbox_messages")
}

model IntegrationCredential {
  id          String   @id @default(uuid())
  accountId   String
  type        String
  name        String
  credentials String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("integration_credentials")
}

model BroadcastCampaign {
  id               String              @id @default(uuid())
  accountId        String
  workspaceId      String?
  name             String
  status           String              @default("draft")
  category         String              @default("marketing")
  languageCode     String              @default("en")
  bodyText         String
  footerText       String              @default("")
  optOutLine       String              @default("Reply STOP to opt out.")
  outside24h       Boolean             @default(true)
  audienceFilter   String              @default("{}")
  scheduleAt       DateTime?
  dailyCap         Int                 @default(250)
  sentCount        Int                 @default(0)
  failedCount      Int                 @default(0)
  promptSource     String?
  metaTemplateName String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  account          Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  recipients       CampaignRecipient[]

  @@map("broadcast_campaigns")
}

model TeamInvite {
  id         String    @id @default(uuid())
  accountId  String
  email      String
  role       String    @default("agent")
  token      String    @unique @default(uuid())
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())
  account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("team_invites")
}

model BookingEvent {
  id           String   @id @default(uuid())
  accountId    String
  contactPhone String
  contactName  String   @default("Customer")
  title        String   @default("Appointment")
  startAt      DateTime
  endAt        DateTime
  notes        String   @default("")
  channel      String   @default("whatsapp")
  status       String   @default("confirmed")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("booking_events")
}

model Subscription {
  id                   String    @id @default(uuid())
  accountId            String    @unique
  planId               String    @default("free_trial")
  status               String    @default("active")
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  account              Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model CreditBalance {
  id             String   @id @default(uuid())
  accountId      String   @unique
  balance        Int      @default(0)
  totalPurchased Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("credit_balances")
}

model CreditTransaction {
  id          String   @id @default(uuid())
  accountId   String
  amount      Int
  type        String
  description String
  createdAt   DateTime @default(now())
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("credit_transactions")
}

model UsageLog {
  id              String   @id @default(uuid())
  accountId       String
  actionType      String
  creditCost      Int
  relatedEntityId String?
  createdAt       DateTime @default(now())
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("usage_logs")
}

// ─── UNIVERSAL BUSINESS MODULES (V1 CORE) ───────────────────────────────────

model Party {
  id             String   @id @default(uuid())
  accountId      String
  workspaceId    String?
  type           String   @default("person") // person | company | vendor
  name           String
  phone          String   @default("")
  email          String   @default("")
  source         String   @default("manual") // whatsapp | instagram | facebook | manual | website | referral
  metadata       String   @default("{}") // JSON for custom fields
  tags           String   @default("[]") // JSON array
  assignedTo     String? // User id
  conversationId String? // Link to InboxConversation
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("parties")
}

model CampaignRecipient {
  id           String            @id @default(uuid())
  campaignId   String
  partyId      String?
  phone        String
  status       String            @default("pending") // pending | sent | delivered | failed | replied
  errorMessage String?
  sentAt       DateTime?
  deliveredAt  DateTime?
  createdAt    DateTime          @default(now())
  campaign     BroadcastCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@map("campaign_recipients")
}

model KnowledgeBase {
  id          String     @id @default(uuid())
  accountId   String
  workspaceId String?
  name        String
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  documents   Document[]

  @@map("knowledge_bases")
}

model Document {
  id              String        @id @default(uuid())
  knowledgeBaseId String
  title           String
  content         String        @db.Text
  metadata        String        @default("{}")
  createdAt       DateTime      @default(now())
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  @@map("documents")
}

model AIAgent {
  id          String   @id @default(uuid())
  accountId   String
  workspaceId String?
  name        String
  persona     String   @db.Text
  model       String   @default("gpt-4o")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("ai_agents")
}

model Template {
  id         String   @id @default(uuid())
  name       String
  category   String
  definition String   @db.Text // Complete Workspace Blueprint (JSON)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("templates")
}

model AuditLog {
  id         String   @id @default(uuid())
  accountId  String
  userId     String?
  action     String
  entityType String
  entityId   String
  details    String   @default("{}")
  createdAt  DateTime @default(now())

  @@map("audit_logs")
}
